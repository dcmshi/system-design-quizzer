# Copy this file to .env and fill in your values.
# All variables use the QUIZZER_ prefix.

# ---------------------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------------------
# 'auto'   — use Gemini if QUIZZER_GEMINI_API_KEY is set, else fall back to Ollama
# 'gemini' — always use Google AI Studio (requires QUIZZER_GEMINI_API_KEY)
# 'ollama' — always use local Ollama
QUIZZER_LLM_PROVIDER=auto

# ---------------------------------------------------------------------------
# Google AI Studio (Gemini)
# ---------------------------------------------------------------------------
# Get your key at https://aistudio.google.com/apikey
QUIZZER_GEMINI_API_KEY=
QUIZZER_GEMINI_MODEL=gemini-2.0-flash
# Seconds to wait between requests — free tier is 15 RPM, so 4s keeps you under
QUIZZER_GEMINI_REQUEST_DELAY=4.0
# Retries on 429 — waits the API-suggested retryDelay between each attempt
QUIZZER_GEMINI_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Ollama (local fallback)
# ---------------------------------------------------------------------------
QUIZZER_OLLAMA_BASE_URL=http://localhost:11434
QUIZZER_OLLAMA_MODEL=llama3.1:8b
QUIZZER_OLLAMA_TEMPERATURE=0.1
QUIZZER_OLLAMA_SEED=42

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
QUIZZER_CONTENT_DIR=content
QUIZZER_DB_PATH=data/quizzer.db

# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------
QUIZZER_CHUNK_WORD_MIN=300
QUIZZER_CHUNK_WORD_MAX=800

# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------
QUIZZER_MIN_EXPLANATION_LENGTH=50
